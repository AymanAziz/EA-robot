# All PT_ values are validated by Pydantic. Do not commit a real .env file.
PT_MODE=paper
# Set oracle on the VM so host-health telemetry is labeled with its actual deployment role.
PT_DEPLOYMENT_ENVIRONMENT=local
# simulator = local fills from real market quotes; brokers = remote paper accounts.
PT_EXECUTION=simulator
PT_DATABASE_URL=sqlite:///var/papertrade.db
PT_STATE_DIR=var
PT_MODELS_DIR=var/models
PT_CAPITAL=10000
PT_RISK_PER_TRADE=0.005
PT_DAILY_LOSS_LIMIT=0.02
PT_MAX_DRAWDOWN=0.10
PT_MAX_POSITIONS=3
PT_MAX_TOTAL_EXPOSURE=0.60
PT_MAX_INSTRUMENT_EXPOSURE=0.20
PT_MAX_CORRELATED_EXPOSURE=0.30
PT_MAX_DATA_AGE_SECONDS=1200
PT_MAX_QUOTE_AGE_SECONDS=60
PT_MODEL_MAX_AGE_DAYS=30
PT_MIN_PROBABILITY=0.60
PT_MIN_NET_EDGE_BPS=5
PT_MIN_VALIDATION_TRADES=30
# Broker-hosted protection is unavailable for Alpaca crypto. Keep disabled unless
# a monitored watchdog is configured and you accept gap/outage exposure in PAPER.
PT_ALLOW_UNHOSTED_PROTECTION=false
PT_WATCHDOG_URL=
# Alpaca PAPER account only. Endpoints are hardcoded to paper in the adapter.
PT_ALPACA_KEY=
PT_ALPACA_SECRET=
# OANDA PRACTICE account only. Must be USD-denominated and API eligible.
PT_OANDA_TOKEN=
PT_OANDA_ACCOUNT_ID=
# Run scripts/configure_env.py to set a password hash and random API token.
PT_ADMIN_USERNAME=admin
PT_ADMIN_PASSWORD_HASH=
PT_API_TOKEN=
PT_API_URL=http://127.0.0.1:8000
PT_DASHBOARD_REFRESH_SECONDS=30
# Real paper integration tests never run unless explicitly enabled.
PT_RUN_PAPER_INTEGRATION=false

# Cloud AI remains OFF until credentials, model and account plan are verified.
# Unprefixed AI_PROVIDER/GROQ_API_KEY/GROQ_MODEL/HERMES_* aliases are also accepted;
# use one spelling for each value. Never copy this section into Streamlit Cloud.
PT_AI_ENABLED=false
PT_AI_PROVIDER=groq
PT_AI_FALLBACK_PROVIDER=none
PT_GROQ_API_KEY=
PT_GROQ_MODEL=
PT_HERMES_API_KEY=
PT_HERMES_MODEL=
PT_HERMES_BASE_URL=https://inference-api.nousresearch.com/v1
# Confirm the account's actual plan before changing unverified -> free.
# Hermes is optional paid access: paid tier + allow_paid=true require explicit authorization.
PT_AI_ACCOUNT_TIER=unverified
PT_AI_ALLOW_PAID=false
PT_AI_TIMEOUT_SECONDS=8
PT_AI_MAX_ATTEMPTS=2
PT_AI_MAX_OUTPUT_TOKENS=512
# json_schema requires a currently supported model/account. No automatic format fallback.
PT_AI_RESPONSE_FORMAT=json_object
PT_TRADING_INTERVAL_MINUTES=15
PT_AI_ANALYSIS_INTERVAL_MINUTES=60
# Local ceilings, not promises about either provider's free-tier allowance.
PT_AI_MAX_DAILY_REQUESTS=100
PT_AI_MAX_DAILY_TOKENS=100000
PT_AI_MAX_AGE_MINUTES=75
PT_AI_RECENT_CANDLES=12
PT_AI_EVENT_PROBABILITY_DELTA=0.10
PT_AI_EVENT_PRICE_CHANGE=0.02
PT_AI_EVENT_MIN_INTERVAL_MINUTES=15
# New entries require explicit strategy enablement and an independently validated quant model.
# AI-dependent strategies additionally require a current approved validation certificate.
PT_STRATEGY=quant_only
PT_STRATEGY_EXECUTION_ENABLED=false
PT_STRATEGY_MIN_VALIDATION_TRADES=30
PT_STRATEGY_MIN_OBSERVATIONS=96
PT_STRATEGY_CERTIFICATE_MAX_AGE_DAYS=30
