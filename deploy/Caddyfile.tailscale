{
	admin off
	auto_https off
}

# Tailscale Funnel terminates public TLS and forwards only to this loopback
# listener. Keep the same public route allowlist and request cap as Caddyfile.api.
:8080 {
	bind 127.0.0.1

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cache-Control "no-store"
		-Server
	}

	request_body {
		max_size 16KB
	}

	@reads {
		method GET
		path /healthz /readyz /status /tables/*
	}
	handle @reads {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	@writes {
		method POST
		path /auth/login /controls
	}
	handle @writes {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		respond "Not found" 404
	}
}
